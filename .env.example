# ============================================================
# LOVART 慢速自动批量生图 - 环境变量样例
# 复制本文件为 .env 并填写真实值（.env 已加入 .gitignore）
# ============================================================

# ---- HTTP 服务 ----
PORT=3000
HOST=0.0.0.0
# 钉钉按钮回调鉴权 token（暂未启用，先占位）
HTTP_AUTH_TOKEN=

# ---- 钉钉表格 ----
# Base ID（就是钉钉文档 ID）—— 卓芝款式素材生成表
DINGTALK_BASE_ID=ZgpG2NdyVX6bMqMaTGgr2nLG8MwvDqPk
# 生图表 tableId（lovart慢速生图表）
DINGTALK_PRODUCT_TABLE_ID=tDKCnjU
# Direct OpenAPI 模式：填 corp 成员 userId 后 recordQuery 绕开 dws CLI。
# 留空 = 走 dws（服务器要装 dws + 设备扫码登录）；填了 = OpenAPI 直连，更稳
DINGTALK_OPERATOR_USERID=

# ---- 钉钉应用鉴权（access_token 自动获取，二选一） ----
# 方式 A：企业内部应用（推荐）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 方式 B：直接给一个长期 access_token（如果你已经有）
DINGTALK_ACCESS_TOKEN=

# ---- 钉钉表字段映射（lovart慢速生图表 tDKCnjU） ----
PRODUCT_FIELD_MODEL_IMAGE=Kazj7iR
PRODUCT_FIELD_RESULT=cFh92nW
PRODUCT_FIELD_STYLE_NO=J9cORMb
PRODUCT_FIELD_STATUS=9LNltPj
PRODUCT_FIELD_GEN_STATUS=XzTcnFY
PRODUCT_FIELD_PROMPT=VgE7ByO

# ---- 并发 ----
WORKER_COUNT=3

# ---- 生图 ----
# 单行 prompt 失败自适应重试
#   重试上限（首次算 attempt 1）
PROMPT_RETRY_MAX=5
#   重试基础退避（ms）— attempt 2 触发后等这么久
PROMPT_RETRY_BASE_MS=300000
#   指数倍数 — attempt 3 等待 = base × mult；attempt 4 = base × mult² …
PROMPT_RETRY_MULT=2
# Lovart 单次等图超时（秒）。限速时可达 20-30+ 分钟
LOVART_GEN_TIMEOUT_SEC=2400

# ---- Lovart 登录态 ----
# cookies 文件路径（由 scripts/manual-login.js 写入）
LOVART_COOKIES_FILE=./data/cookies.json
# 钉钉/服创器部署环境变量（可选）
LOVART_HOME_URL=https://www.lovart.ai/zh/home

# ---- 日志 ----
LOG_LEVEL=info
LOG_DIR=./logs

# ---- 生图结果输出目录 ----
LOVART_OUTPUT_DIR=C:\lovart生图结果

# ---- 验证码 ----
# 2Captcha API key（用于解 Lovart hCaptcha）：https://2captcha.com 注册充值
# hCaptcha 约 $0.003/次
TWO_CAPTCHA_API_KEY=
