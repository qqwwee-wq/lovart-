# ============================================================
# LOVART 慢速自动批量生图 - 环境变量样例
# 复制本文件为 .env 并填写真实值（.env 已加入 .gitignore）
# ============================================================

# ---- HTTP 服务 ----
PORT=3000
HOST=0.0.0.0
# 钉钉按钮回调鉴权 token（暂未启用，先占位）
HTTP_AUTH_TOKEN=

# ---- 钉钉表格 ----
# Base ID（就是钉钉文档 ID）
DINGTALK_BASE_ID=R1zknDm0WRqdKyKks0ONRg4w8BQEx5rG
# 生图表 tableId
DINGTALK_PRODUCT_TABLE_ID=hERWDMS
# 生图提示词表 tableId
DINGTALK_PROMPT_TABLE_ID=hla8YBu

# ---- 钉钉应用鉴权（access_token 自动获取，二选一） ----
# 方式 A：企业内部应用（推荐）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 方式 B：直接给一个长期 access_token（如果你已经有）
DINGTALK_ACCESS_TOKEN=

# ---- 钉钉表字段映射（按 docs/tables-schema.json 实际值填） ----
# 生图表
PRODUCT_FIELD_MODEL_IMAGE=DnmBokE
PRODUCT_FIELD_RESULT=szTnEwE
PRODUCT_FIELD_RESULT_HALF=6z0bsDG
PRODUCT_FIELD_NEED_HALF=d0kMhUg
PRODUCT_FIELD_STYLE_NO=bbhOm6a
PRODUCT_FIELD_STATUS=RicGRRL

# 提示词表
PROMPT_FIELD_REQUIREMENTS=K8j3XfP
PROMPT_FIELD_TASK_TYPE=qPAYcMw
PROMPT_FIELD_RESOLUTION=XNg9do5
PROMPT_FIELD_RATIO=2yoWPdm
PROMPT_FIELD_COUNT=wYvotko
PROMPT_FIELD_RULES=XwixyRq

# ---- 并发 & 模型 ----
WORKER_COUNT=5
LOVART_MODEL=Nano Banana 2
IMAGE_RATIO=3:4
IMAGE_RESOLUTION=2K
IMAGES_PER_PROMPT=5

# ---- Lovart 登录态 ----
# cookies 文件路径（由 scripts/manual-login.js 写入）
LOVART_COOKIES_FILE=./data/cookies.json
# 钉钉/服创器部署环境变量（可选）
LOVART_HOME_URL=https://www.lovart.ai/zh/home

# ---- 日志 ----
LOG_LEVEL=info
LOG_DIR=./logs
