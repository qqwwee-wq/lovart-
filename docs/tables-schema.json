  "business_logic": {
    "rule": "对生图表的每一行：若「是否需要半身照」=「否」→ 用 lovart生图 任务的 N 条提示词（写入「生成结果」）；若=「是」→ 同时用 lovart生图 + lovart生图（半身照） 的所有提示词（lovart生图 的图写「生成结果」，半身照的图写「生成结果（半身照）」）",
    "row_buckets": {
      "否_row": {
        "prompts_used": ["lovart生图"],
        "total_images": 10,
        "write_target": "生成结果"
      },
      "是_row": {
        "prompts_used": ["lovart生图", "lovart生图（半身照）"],
        "total_images": 15,
        "write_target": { "lovart生图": "生成结果", "lovart生图（半身照）": "生成结果（半身照）" }
      }
    },
    "model": "Nano Banana 2",
    "ratio": "3:4",
    "resolution": "2K",
    "per_prompt_image_count": 5,
    "open_questions_for_user": [
